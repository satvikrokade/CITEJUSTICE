# =====================================================================
# CiteJustice / NyayaAnumana Environment Configuration Template
# =====================================================================

# 1. Hugging Face Access Token
# Paste your personal access token (starts with hf_...) below:
HF_TOKEN=your_huggingface_token_here

# 2. Target Pretrained Models & Datasets
HF_MODEL_NAME=L-NLProc/InLegalLlama
HF_DATASET_NAME=L-NLProc/NyayaAnumana

# 3. Execution & Hardware Preferences
# Options: cuda, cpu
DEVICE=cuda

# Quantization (4bit recommended for GPUs with limited VRAM)
LOAD_IN_4BIT=True
